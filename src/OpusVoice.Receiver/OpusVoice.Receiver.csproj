<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <!-- Local checkout of Pinhole.Net as a sibling directory; override with -p:PinholeRoot=/path/to/Pinhole.Net -->
    <PinholeRoot Condition="'$(PinholeRoot)' == ''">$(MSBuildThisFileDirectory)../../../Pinhole.Net</PinholeRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(PinholeRoot)/src/Pinhole/Pinhole.csproj" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
